root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,vue,json,jsonc,yml,yaml,html,css,scss,md}]
indent_size = 2

[*.{cs,csproj,sln,props,targets}]
indent_size = 4
end_of_line = crlf

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
